using Oxygen;

namespace OxygenEditor;

int Main()
{
    if (!OpenWindow(1600, 1000, "Oxygen - Scene Editor"))
    {
        return 1;
    }
    InitializeEditorLogic();
    if (ed_init() == 0)
    {
        ed_close();
        CloseEditorLogic();
        CloseWindow();
        return 1;
    }
    Editor *editor = new Editor();
    TileDocument *tile = new TileDocument();
    int smoke = Option("OXYGEN_EDITOR_SMOKE");
    int frames = 0;
    int failures = 0;
    int meshSlot = -1;

    if (smoke != 0)
    {
        failures += EditorChecks(editor);
        int meshAsset = ed_asset_find("Props/Crate.obj");
        meshSlot = editor->Document.Add(6, Vector3(10.0f, 0.0f, 10.0f), 25.0f, meshAsset, 0);
        if (meshAsset == 0 || meshSlot < 0)
        {
            failures++;
        }
        editor->Document.Commit();
        int before = editor->Document.Count();
        editor->Document.Add(2, Vector3(5.0f, 0.0f, 1.0f), 0.0f, 0, 2);
        editor->Document.Commit();
        editor->Document.Restore(editor->Document.Cursor - 1);
        if (editor->Document.Count() != before)
        {
            failures++;
        }
        editor->Document.Restore(editor->Document.Cursor + 1);
        if (editor->Document.Count() != before + 1)
        {
            failures++;
        }
        if (!editor->Save(false))
        {
            failures++;
        }
        if (ed_load(&editor->Document.Data[0], Capacity, 1) == 0)
        {
            failures++;
        }
        if (editor->Document.Count() != before + 1)
        {
            failures++;
        }
        failures += ed_storage_test(&editor->Document.Data[0]);
    }

    while (true)
    {
        if (ShouldClose() || editor->Quit)
        {
            if (editor->MayLeave())
            {
                break;
            }
            editor->Quit = false;
        }
        float dt = Min(FrameTime(), 0.05f);
        if (smoke != 0)
        {
            dt = PhysicsStep;
        }
        BeginFrame(0x13171EFFu);
        editor->FillUI();
        int action = ed_ui(&editor->UI[0], &editor->Document.Data[0]);
        tile->Update();
        editor->Action(action);
        editor->Update(dt);
        editor->Render();
        ed_present();
        frames++;

        if (smoke != 0 && frames == 5)
        {
            Screenshot("oxygen-editor.png");
        }
        if (smoke != 0 && frames == 6)
        {
            editor->Play();
            if (!editor->Playing)
            {
                failures++;
            }
            else if (meshSlot >= 0)
            {
                int slot = editor->PlaySlots[meshSlot];
                Scene *scene = editor->Game->Rooms[0].Value;
                if (slot < 0 || scene->Objects[slot].Body.Handle == 0)
                {
                    failures++;
                    Log("FAIL: editor mesh collider in Play.");
                }
                else
                {
                    RayHit hit = Raycast(scene->Physics, Vector3(10.0f, 8.0f, 10.0f),
                                         Vector3(0.0f, -1.0f, 0.0f), 10.0f, 0);
                    if (hit.Entity != scene->Objects[slot].Id)
                    {
                        failures++;
                    }
                    else
                    {
                        Log("PASS: editor creates model triangle collider in Play.");
                    }
                }
            }
        }
        if (smoke != 0 && frames == 80)
        {
            Screenshot("oxygen-editor-play.png");
        }
        EndFrame();
        if (smoke != 0 && frames >= 90)
        {
            break;
        }
    }

    if (smoke != 0)
    {
        if (editor->Playing && !editor->Game->Grounded())
        {
            failures++;
        }
        editor->Stop();
        if (failures == 0)
        {
            Log("PASS: editor history, scene save/load, play mode and grounded player.");
        }
        else
        {
            Log("FAIL: editor regression checks.");
        }
    }

    delete (tile);
    delete (editor);
    ed_close();
    CloseEditorLogic();
    CloseWindow();
    return failures;
}
