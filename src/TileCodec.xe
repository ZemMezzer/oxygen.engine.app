using Oxygen;
using Xenon.Text;
using Xenon.IO;

namespace OxygenEditor;

extern void ed_bind_tile_codec(function int(int, readonly byte *, float *, byte *, byte *) * callback);
extern void ed_bind_tile_mesh(function int(float *, float *, ushort *, int *) * callback);

struct TileMetadata
{
    public String Name;
    public String Texture;
}

int ResourceKind(readonly String& path)
{
    String suffix = String(Path.GetExtension(path.AsView()));
    StringBuilder lower = StringBuilder();
    for (int i = 0; i < suffix.Length; i++)
    {
        char c = suffix[i];
        if (c >= cast<char>(65) && c <= cast<char>(90))
        {
            c = cast<char>(cast<int>(c) + 32);
        }
        lower.Append(c);
    }
    suffix = lower.ToString();
    if (suffix.Equals(String(".png")) || suffix.Equals(String(".jpg")) || suffix.Equals(String(".jpeg")) ||
        suffix.Equals(String(".bmp")) || suffix.Equals(String(".tga")))
    {
        return 1;
    }
    if (suffix.Equals(String(".oxtile")))
    {
        return 5;
    }
    if (suffix.Equals(String(".obj")) || suffix.Equals(String(".gltf")) || suffix.Equals(String(".glb")) ||
        suffix.Equals(String(".iqm")))
    {
        return 2;
    }
    if (suffix.Equals(String(".wav")) || suffix.Equals(String(".ogg")) || suffix.Equals(String(".mp3")) ||
        suffix.Equals(String(".flac")))
    {
        return 3;
    }
    return 4;
}

bool ValidTile(float *data)
{
    for (int i = 0; i < TileDataSize; i++)
    {
        if (data[i] != data[i] || Abs(data[i]) > 3.402823466e38f)
        {
            return false;
        }
    }
    for (int i = 0; i < TileVertices; i++)
    {
        float *v = data + i * 4;
        if ((v[0] != 0.0f && v[0] != 1.0f) || Abs(v[1]) > 1000.0f || Abs(v[2]) > 1000.0f ||
            Abs(v[3]) > 1000.0f)
        {
            return false;
        }
    }
    for (int i = 0; i < TileFaces; i++)
    {
        float *f = data + TileFaceStart + i * TileFaceStride;
        if (f[0] != 0.0f && f[0] != 1.0f)
        {
            return false;
        }
        if (f[0] == 0.0f)
        {
            continue;
        }
        for (int j = 1; j <= 4; j++)
        {
            if (f[j] < 0.0f || f[j] >= cast<float>(TileVertices) || f[j] != cast<float>(cast<int>(f[j])) ||
                data[cast<int>(f[j]) * 4] == 0.0f)
            {
                return false;
            }
        }
        for (int j = 5; j <= 12; j++)
        {
            if (f[j] < 0.0f || f[j] > 1.0f)
            {
                return false;
            }
        }
    }
    return true;
}

bool ReadTileFile(readonly String &path, float *destination, TileMetadata *metadata)
{
    TextReader reader = TextReader(File.ReadAllText(path));
    String magic = reader.Token();
    int version = reader.Integer();
    TileMetadata result = TileMetadata();
    result.Name = reader.Token();
    result.Texture = reader.Token();
    int vertices = reader.Integer();
    int faces = reader.Integer();
    if (!magic.Equals(String("OXYGEN_TILE")) || (version != 1 && version != 2) ||
        result.Name.ByteLength == 0 || result.Name.ByteLength >= 128 || result.Texture.ByteLength >= 32768 ||
        (result.Texture.ByteLength > 0 &&
         (!SafeAssetPath(result.Texture) || ResourceKind(result.Texture) != 1)) ||
        vertices < 0 || vertices > TileVertices || faces < 0 || faces > TileFaces)
    {
        return false;
    }
    unique<float[]> data = new float[TileDataSize];
    for (int i = 0; i < vertices; i++)
    {
        int id = reader.Integer();
        if (id < 0 || id >= TileVertices || data[id * 4] != 0.0f)
        {
            return false;
        }
        data[id * 4] = 1.0f;
        for (int j = 1; j < 4; j++)
        {
            data[id * 4 + j] = cast<float>(reader.Number());
        }
    }
    for (int i = 0; i < faces; i++)
    {
        int id = reader.Integer();
        if (id < 0 || id >= TileFaces || data[TileFaceStart + id * TileFaceStride] != 0.0f)
        {
            return false;
        }
        int at = TileFaceStart + id * TileFaceStride;
        data[at] = 1.0f;
        int fields = TileFaceStride;
        if (version == 1)
        {
            fields = 9;
        }
        for (int j = 1; j < fields; j++)
        {
            data[at + j] = cast<float>(reader.Number());
        }
        if (version == 1)
        {
            float u0 = data[at + 5];
            float v0 = data[at + 6];
            float u1 = data[at + 7];
            float v1 = data[at + 8];
            data[at + 5] = u0;
            data[at + 6] = v1;
            data[at + 7] = u1;
            data[at + 8] = v1;
            data[at + 9] = u1;
            data[at + 10] = v0;
            data[at + 11] = u0;
            data[at + 12] = v0;
        }
    }
    if (!ValidTile(&data[0]))
    {
        return false;
    }
    for (int i = 0; i < TileDataSize; i++)
    {
        destination[i] = data[i];
    }
    *metadata = result;
    return true;
}

bool WriteTileFile(readonly String &path, float *data, readonly TileMetadata &metadata)
{
    if (!ValidTile(data))
    {
        return false;
    }
    StringBuilder output = StringBuilder();
    output.Append("OXYGEN_TILE 2\n");
    Quoted(&output, metadata.Name);
    output.Append("\n");
    Quoted(&output, metadata.Texture);
    output.Append("\n");
    int vertices = 0;
    int faces = 0;
    for (int i = 0; i < TileVertices; i++)
    {
        if (data[i * 4] != 0.0f)
        {
            vertices++;
        }
    }
    for (int i = 0; i < TileFaces; i++)
    {
        if (data[TileFaceStart + i * TileFaceStride] != 0.0f)
        {
            faces++;
        }
    }
    output.Append(vertices);
    output.Append(" ");
    output.Append(faces);
    output.Append("\n");
    for (int i = 0; i < TileVertices; i++)
    {
        if (data[i * 4] == 0.0f)
        {
            continue;
        }
        output.Append(i);
        for (int j = 1; j < 4; j++)
        {
            output.Append(" ");
            output.Append(data[i * 4 + j]);
        }
        output.Append("\n");
    }
    for (int i = 0; i < TileFaces; i++)
    {
        int at = TileFaceStart + i * TileFaceStride;
        if (data[at] == 0.0f)
        {
            continue;
        }
        output.Append(i);
        for (int j = 1; j < TileFaceStride; j++)
        {
            output.Append(" ");
            output.Append(data[at + j]);
        }
        output.Append("\n");
    }
    return SaveTextAtomic(path, output.ToString());
}

void CopyText(byte *target, readonly String &value)
{
    for (int i = 0; i <= value.ByteLength; i++)
    {
        target[i] = value.CString[i];
    }
}

int TileCodecDispatch(int operation, readonly byte *path, float *data, byte *name, byte *texture)
{
    try
    {
        if (operation == 1)
        {
            if (ValidTile(data))
            {
                return 1;
            }
            return 0;
        }
        if (operation == 3)
        {
            return ResourceKind(String(path));
        }
        TileMetadata metadata = TileMetadata();
        if (operation == 0 && ReadTileFile(String(path), data, &metadata))
        {
            CopyText(name, metadata.Name);
            CopyText(texture, metadata.Texture);
            return 1;
        }
        if (operation == 4)
        {
            metadata.Name = String(name);
            metadata.Texture = String(texture);
            if (ExportTileMesh(String(path), data, metadata))
            {
                return 1;
            }
            return 0;
        }
        if (operation == 2)
        {
            metadata.Name = String(name);
            metadata.Texture = String(texture);
            if (WriteTileFile(String(path), data, metadata))
            {
                return 1;
            }
        }
    }
    catch (...)
    {
        return 0;
    }
    return 0;
}
