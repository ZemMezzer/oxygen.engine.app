using Oxygen;

namespace OxygenEditor;

struct AtlasController
{
    public bool Selecting;
    public bool Dragging;
    public bool Armed;
    public bool HasSelection;
    public bool UVGesture;
    public int Corner;
    public float StartX;
    public float StartY;

    public void Reset()
    {
        Selecting = false;
        Dragging = false;
        Armed = false;
        HasSelection = false;
        UVGesture = false;
        Corner = -1;
    }

    public int Update(float *data, float *uv, float *corners, float *input, float *values)
    {
        int action = 0;
        float x = input[8];
        float y = input[9];
        float textureWidth = input[10];
        float textureHeight = input[11];
        int face = cast<int>(input[16]);
        if (input[0] == 0.0f)
        {
            if (input[2] != 0.0f && input[3] != 0.0f)
            {
                bool inside = HasSelection && x >= uv[0] && x <= uv[2] && y >= uv[1] && y <= uv[3];
                Armed = inside && input[7] == 0.0f;
                Selecting = !Armed;
                StartX = x;
                StartY = y;
            }
            if (Selecting)
            {
                int cellX = cast<int>(input[14]);
                int cellY = cast<int>(input[15]);
                int x0 = cast<int>(Min(StartX, x) * textureWidth) / cellX * cellX;
                int y0 = cast<int>(Min(StartY, y) * textureHeight) / cellY * cellY;
                int x1 = (cast<int>(Max(StartX, x) * textureWidth) / cellX + 1) * cellX;
                int y1 = (cast<int>(Max(StartY, y) * textureHeight) / cellY + 1) * cellY;
                uv[0] = Min(cast<float>(x0), textureWidth - 1.0f) / textureWidth;
                uv[1] = Min(cast<float>(y0), textureHeight - 1.0f) / textureHeight;
                uv[2] = Min(cast<float>(x1), textureWidth) / textureWidth;
                uv[3] = Min(cast<float>(y1), textureHeight) / textureHeight;
                HasSelection = true;
                if (input[4] != 0.0f)
                {
                    Selecting = false;
                }
            }
            if (Armed && input[5] != 0.0f)
            {
                Dragging = true;
            }
        }
        else if (input[1] != 0.0f)
        {
            if (!UVGesture)
            {
                for (int i = 0; i < 8; i++)
                {
                    corners[i] = data[TileFaceStart + face * TileFaceStride + 5 + i];
                }
            }
            if (input[2] != 0.0f && input[3] != 0.0f)
            {
                Corner = -1;
                float distance = 12.0f;
                for (int i = 0; i < 4; i++)
                {
                    float d = ScreenDistance(
                        ScreenPoint(corners[i * 2] * input[12], corners[i * 2 + 1] * input[13]),
                        ScreenPoint(x * input[12], y * input[13]));
                    if (d < distance)
                    {
                        distance = d;
                        Corner = i;
                    }
                }
                UVGesture = Corner >= 0;
            }
            if (UVGesture)
            {
                if (input[6] != 0.0f)
                {
                    action = 17;
                    UVGesture = false;
                    Corner = -1;
                }
                else if (input[4] != 0.0f)
                {
                    action = 16;
                    UVGesture = false;
                    Corner = -1;
                }
                else if (input[5] != 0.0f && Corner >= 0)
                {
                    corners[Corner * 2] = roundf(x * textureWidth) / textureWidth;
                    corners[Corner * 2 + 1] = roundf(y * textureHeight) / textureHeight;
                    action = 24;
                    values[0] = cast<float>(face);
                    for (int i = 0; i < 8; i++)
                    {
                        values[8 + i] = corners[i];
                    }
                }
            }
        }
        return action;
    }
}

static struct AtlasService
{
    public static AtlasController *State;
}

extern void ed_bind_atlas(function int(int, float *, float *, float *, float *, float *, float *) * callback);

int AtlasDispatch(int operation, float *data, float *uv, float *corners, float *input, float *values,
                  float *display)
{
    AtlasController *state = AtlasService.State;
    int action = 0;
    if (operation == 0)
    {
        action = state->Update(data, uv, corners, input, values);
    }
    if (operation == 1)
    {
        state->Reset();
        SelectionService.Rectangle->Active = false;
        SelectionService.Rectangle->Dragged = false;
    }
    if (operation == 2)
    {
        state->HasSelection = true;
    }
    if (operation == 3)
    {
        state->Dragging = false;
        state->Armed = false;
        state->Selecting = false;
    }
    if (operation == 4)
    {
        float x = corners[0];
        float y = corners[1];
        for (int i = 0; i < 6; i++)
        {
            corners[i] = corners[i + 2];
        }
        corners[6] = x;
        corners[7] = y;
    }
    if (operation == 5)
    {
        for (int i = 0; i < 2; i++)
        {
            float swap = corners[i];
            corners[i] = corners[i + 2];
            corners[i + 2] = swap;
            swap = corners[4 + i];
            corners[4 + i] = corners[6 + i];
            corners[6 + i] = swap;
        }
    }
    if (display != null)
    {
        for (int i = 0; i < 6; i++)
        {
            display[i] = 0.0f;
        }
        if (state->Selecting)
        {
            display[0] = 1.0f;
        }
        if (state->Dragging)
        {
            display[1] = 1.0f;
        }
        if (state->Armed)
        {
            display[2] = 1.0f;
        }
        if (state->HasSelection)
        {
            display[3] = 1.0f;
        }
        if (state->UVGesture)
        {
            display[4] = 1.0f;
        }
        display[5] = cast<float>(state->Corner);
    }
    return action;
}
