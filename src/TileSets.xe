using Xenon.Text;
using Xenon.Collections;
using Xenon.IO;

namespace OxygenEditor;

struct TileSetDocument
{
    public String Name;
    public Vector<String> Members;

    public bool Contains(readonly String &path)
    {
        for (int i = 0; i < Members.Count; i++)
        {
            if (Members.Get(i)->Equals(path))
            {
                return true;
            }
        }
        return false;
    }

    public TileSetDocument Clone()
    {
        TileSetDocument copy = TileSetDocument();
        copy.Name = Name;
        for (int i = 0; i < Members.Count; i++)
        {
            copy.Members.Add(*Members.Get(i));
        }
        return move copy;
    }

    public bool SameMembers(TileSetDocument *other)
    {
        if (Members.Count != other->Members.Count)
        {
            return false;
        }
        for (int i = 0; i < Members.Count; i++)
        {
            if (!Members.Get(i)->Equals(*other->Members.Get(i)))
            {
                return false;
            }
        }
        return true;
    }
}

struct TileSetEdit
{
    public String Set;
    public TileSetDocument Before;
    public TileSetDocument After;
}

static struct TileSetService
{
    public static Vector<TileSetEdit *> *History;
    public static int Cursor;
}

TileSetDocument
ReadTileSet(readonly String &tileset)
{
    if (!SafeAssetPath(tileset))
    {
        throw 1;
    }
    TextReader reader =
        TextReader(File.ReadAllText(JoinPath(AssetFile(tileset), String("tileset.oxtileset"))));
    String magic = reader.Token();
    int version = reader.Integer();
    TileSetDocument result = TileSetDocument();
    result.Name = reader.Token();
    if (!magic.Equals(String("OXYGEN_TILESET")) || (version != 1 && version != 2))
    {
        throw 1;
    }
    if (version == 1)
    {
        Vector<FileEntry> entries = ListFiles(AssetFile(tileset), false);
        for (int i = 0; i < entries.Count; i++)
        {
            FileEntry *entry = entries.Get(i);
            if (entry->Kind == 1 && String(Path.GetExtension(entry->Path.AsView())).Equals(String(".oxtile")))
            {
                result.Members.Add(NativePath(2, entry->Path, AssetRoot()));
            }
        }
    }
    else
    {
        int count = reader.Integer();
        if (count < 0 || count > 4096)
        {
            throw 1;
        }
        for (int i = 0; i < count; i++)
        {
            String path = NativePath(1, reader.Token(), String());
            if (!TileAssetPath(path))
            {
                throw 1;
            }
            if (!result.Contains(path))
            {
                result.Members.Add(path);
            }
        }
    }
    return move result;
}

bool WriteTileSet(readonly String &tileset, TileSetDocument *value)
{
    if (!SafeAssetPath(tileset) || value->Members.Count > 4096)
    {
        return false;
    }
    StringBuilder output = StringBuilder();
    output.Append("OXYGEN_TILESET 2\n");
    Quoted(&output, value->Name);
    output.Append("\n");
    output.Append(value->Members.Count);
    output.Append("\n");
    for (int i = 0; i < value->Members.Count; i++)
    {
        String path = *value->Members.Get(i);
        if (!TileAssetPath(path))
        {
            return false;
        }
        Quoted(&output, path);
        output.Append("\n");
    }
    return SaveTextAtomic(JoinPath(AssetFile(tileset), String("tileset.oxtileset")), output.ToString());
}

bool ChangeTileSet(readonly String &tileset, int count, readonly byte **paths, bool add, bool history)
{
    TileSetDocument before = ReadTileSet(tileset);
    TileSetDocument after = before.Clone();
    for (int i = 0; i < count; i++)
    {
        String path = String(paths[i]);
        if (add)
        {
            unique<float[]> data = new float[TileDataSize];
            TileMetadata metadata = TileMetadata();
            if (!TileAssetPath(path) || !ReadTileFile(AssetFile(path), &data[0], &metadata))
            {
                return false;
            }
            if (!after.Contains(path))
            {
                after.Members.Add(path);
            }
        }
        else
        {
            for (int j = after.Members.Count - 1; j >= 0; j--)
            {
                if (after.Members.Get(j)->Equals(path))
                {
                    after.Members.RemoveAt(j);
                }
            }
        }
    }
    if (after.SameMembers(&before))
    {
        return true;
    }
    if (!WriteTileSet(tileset, &after))
    {
        return false;
    }
    if (history)
    {
        while (TileSetService.History->Count > TileSetService.Cursor)
        {
            int last = TileSetService.History->Count - 1;
            delete (*TileSetService.History->Get(last));
            TileSetService.History->RemoveAt(last);
        }
        if (TileSetService.History->Count == 32)
        {
            delete (*TileSetService.History->Get(0));
            TileSetService.History->RemoveAt(0);
        }
        TileSetEdit *edit = new TileSetEdit();
        edit->Set = tileset;
        edit->Before = move before;
        edit->After = move after;
        TileSetService.History->Add(edit);
        TileSetService.Cursor = TileSetService.History->Count;
    }
    return true;
}

void ClearTileSetHistory()
{
    for (int i = 0; i < TileSetService.History->Count; i++)
    {
        delete (*TileSetService.History->Get(i));
    }
    TileSetService.History->Clear();
    TileSetService.Cursor = 0;
}

extern void ed_tileset_view(int operation, readonly byte *text);
extern void ed_bind_tilesets(function int(int, readonly byte *, int, readonly byte **, readonly byte *, int) *
                             callback);

int TileSetsDispatch(int operation, readonly byte *setPath, int count, readonly byte **paths,
                     readonly byte *name, int flags)
{
    try
    {
        if (operation == 6)
        {
            ClearTileSetHistory();
            return 1;
        }
        if (operation == 7)
        {
            return TileSetService.Cursor;
        }
        if (operation == 4 || operation == 5)
        {
            int index = TileSetService.Cursor - 1;
            if (operation == 5)
            {
                index = TileSetService.Cursor;
            }
            if (index < 0 || index >= TileSetService.History->Count)
            {
                return 0;
            }
            TileSetEdit *edit = *TileSetService.History->Get(index);
            TileSetDocument *value = &edit->Before;
            if (operation == 5)
            {
                value = &edit->After;
            }
            if (!WriteTileSet(edit->Set, value))
            {
                return 0;
            }
            TileSetService.Cursor = index;
            if (operation == 5)
            {
                TileSetService.Cursor++;
            }
            ed_tileset_view(2, edit->Set.CString);
            return 1;
        }
        String tileset = String(setPath);
        if (operation == 8)
        {
            if (TileAssetPath(tileset))
            {
                return 1;
            }
            return 0;
        }
        if (operation == 0)
        {
            TileSetDocument result = ReadTileSet(tileset);
            ed_tileset_view(0, result.Name.CString);
            for (int i = 0; i < result.Members.Count; i++)
            {
                ed_tileset_view(1, result.Members.Get(i)->CString);
            }
            return 1;
        }
        if (operation == 1)
        {
            TileSetDocument value = TileSetDocument();
            value.Name = String(name);
            for (int i = 0; i < count; i++)
            {
                value.Members.Add(String(paths[i]));
            }
            if (WriteTileSet(tileset, &value))
            {
                return 1;
            }
            return 0;
        }
        if (ChangeTileSet(tileset, count, paths, operation == 2, flags != 0))
        {
            return 1;
        }
    }
    catch (...)
    {
        return 0;
    }
    return 0;
}
