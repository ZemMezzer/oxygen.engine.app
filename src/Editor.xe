using Oxygen;

namespace OxygenEditor;

struct Editor
{
    public Document Document;
    public Camera Camera;
    public GameWorld *Game;
    public float[] UI;
    public float[] Ray;
    public int[] PlaySlots;
    public int Brush;
    public int GizmoMode;
    public int Layer;
    public int WorldLayer;
    public bool SoloLayer;
    public int StrokePlane;
    public float StrokeDepth;
    public float Rotation;
    public int Selected;
    public int Texture;
    public int TileAsset;
    public int Checker;
    public bool Stroke;
    public bool Changed;
    public bool Playing;
    public bool Grid;
    public bool Flying;
    public Vector3 LastCell;
    public bool HasLastCell;
    public bool Quit;
    public float[] TransformBefore;
    public int TransformRoot;

    public Editor()
    {
        Document = Document();
        Camera = Camera();
        Camera.Position = Vector3(15.0f, 14.0f, 19.0f);
        Camera.Yaw = -0.65f;
        Camera.Pitch = -0.53f;
        UI = new float[32];
        TransformBefore = new float[RecordSize];
        TransformRoot = -1;
        Ray = new float[6];
        PlaySlots = new int[Capacity];
        Brush = 0;
        GizmoMode = 1;
        Selected = -1;
        Grid = true;
        HasLastCell = false;
        StrokePlane = -1;
        Checker = CheckerTexture(128, 2, 0xCFD9E0FFu, 0x929FAAFFu);
        Document.Starter();

        if (ed_load(&Document.Data[0], Capacity, 1) != 0)
        {
            Document.ResetHistory();
        }
    }

    public ~Editor()
    {
        FinishGizmo(true);
        if (Game != null)
        {
            delete (Game);
        }

        ReleaseTexture(Checker);
        delete (Ray);
        delete (PlaySlots);
        delete (UI);
        delete (TransformBefore);
    }

    public void FinishStroke()
    {
        if (Changed)
        {
            Document.Commit();
        }

        Changed = false;
        Stroke = false;
        HasLastCell = false;
        StrokePlane = -1;
    }

    public void RememberTransform()
    {
        TransformRoot = Selected;
        for (int i = 0; i < RecordSize; i++)
        {
            TransformBefore[i] = Document.Data[i];
        }
    }

    public void FollowTransform()
    {
        SnapWorldTile(&Document.Data[0], TransformRoot);
        Document.FollowTransform(&TransformBefore[0], TransformRoot);
        if (!ConstrainTileChanges(&Document.Data[0], &TransformBefore[0]) ||
            ed_validate_scene(&Document.Data[0]) == 0)
        {
            for (int i = 0; i < RecordSize; i++)
            {
                Document.Data[i] = TransformBefore[i];
            }
            ed_status("Transform cancelled: occupied tile cells or invalid transform.");
        }
    }

    public void FinishGizmo(bool cancel)
    {
        int value = 0;
        if (cancel)
        {
            value = 1;
        }
        int result = ed_gizmo_finish(value);
        if (result != 0)
        {
            if (cancel)
            {
                for (int i = 0; i < RecordSize; i++)
                {
                    Document.Data[i] = TransformBefore[i];
                }
            }
            else
            {
                FollowTransform();
            }
            if (result == 2)
            {
                Document.Commit();
            }
        }
    }

    public bool Save(bool another)
    {
        FinishGizmo(false);
        FinishStroke();
        int result = 0;

        if (another)
        {
            result = ed_save_as(&Document.Data[0], Capacity);
        }
        else
        {
            result = ed_save(&Document.Data[0], Capacity);
        }

        if (result != 0)
        {
            Document.Dirty = false;
        }

        return result != 0;
    }

    public bool MayLeave()
    {
        FinishGizmo(true);
        FinishStroke();
        int dirty = 0;
        if (Document.Dirty || ed_gizmo_active() != 0)
        {
            dirty = 1;
        }
        int answer = ed_guard(dirty);
        if (answer == 2)
        {
            return Save(false);
        }
        return answer == 1;
    }

    public void FillUI()
    {
        for (int i = 0; i < 32; i++)
        {
            UI[i] = 0.0f;
        }
        UI[24] = cast<float>(WorldLayer);
        if (SoloLayer)
        {
            UI[25] = 1.0f;
        }
        UI[20] = cast<float>(GizmoMode);
        UI[0] = cast<float>(Brush);
        UI[1] = cast<float>(Layer);
        UI[2] = Rotation;
        UI[3] = cast<float>(Selected);
        UI[4] = cast<float>(Document.Count());
        if (Document.Dirty || ed_gizmo_active() != 0)
        {
            UI[5] = 1.0f;
        }
        if (Playing)
        {
            UI[6] = 1.0f;
        }
        if (Document.Cursor > 0)
        {
            UI[18] = 1.0f;
        }
        if (Document.Cursor + 1 < Document.HistoryCount)
        {
            UI[19] = 1.0f;
        }

        if (Selected >= 0)
        {
            int at = Selected * Stride;
            UI[22] = Document.Data[at + 12];
            UI[23] = Document.Data[at + 13];
            UI[7] = Document.Data[at];

            for (int i = 0; i < 7; i++)
            {
                UI[8 + i] = Document.Data[at + 1 + i];
            }
            UI[15] = Document.Data[at + 10];
            UI[16] = Document.Data[at + 11];
            if (IsWorldTile(&Document.Data[0], Selected))
            {
                Bounds cells = TileCells(MakePrimitive(&Document.Data[0], Selected));
                UI[26] = (cells.High.X - cells.Low.X) * 2.0f;
                UI[27] = (cells.High.Y - cells.Low.Y) * 2.0f;
                UI[28] = (cells.High.Z - cells.Low.Z) * 2.0f;
            }
        }
    }

    public void Stop()
    {
        if (Game != null)
        {
            delete (Game);
        }
        Game = null;
        Playing = false;
        ed_capture(0);
        ed_stop_sound();
        ed_status("Returned to editing. Play-mode changes were discarded.");
    }

    public void Play()
    {
        FinishGizmo(false);
        FinishStroke();
        Game = new GameWorld();
        Scene *scene = new Scene(1, Capacity);
        scene->Ambient = Vector3(0.3f, 0.32f, 0.36f);
        scene->AddLight(Light(0, Vector3(-0.4f, -1.0f, -0.3f), 0xE0EEFFFFu, 0.7f, 1.0f));
        scene->BindTexture(1, Checker);
        Vector3 spawn = Vector3(1.0f, 0.05f, 5.0f);
        float yaw = 0.0f;
        int textureSlot = 2;

        for (int i = 0; i < Capacity; i++)
        {
            int at = i * Stride;
            PlaySlots[i] = -1;
            int kind = cast<int>(Document.Data[at]);
            if (kind == 0)
            {
                continue;
            }
            Vector3 origin = Vector3(Document.Data[at + 1], Document.Data[at + 2], Document.Data[at + 3]);

            if (kind == 9)
            {
                spawn = Add(origin, Vector3(0.0f, 0.05f, 0.0f));
                yaw = Document.Data[at + 4] * Pi / 180.0f;
                continue;
            }

            if (kind == 7)
            {
                scene->AddLight(Light(1, origin, Palette(cast<int>(Document.Data[at + 9])),
                                      Document.Data[at + 11], 12.0f));
                continue;
            }

            if (kind == 8)
            {
                continue;
            }
            Primitive value = MakePrimitive(&Document.Data[0], i);
            value.Tag = i + 1;
            int motion = cast<int>(Document.Data[at + 10]);
            if (IsWorldTile(&Document.Data[0], i))
            {
                motion = 0;
            }
            value.Physics.Motion = BodyStatic;
            if (motion == 1)
            {
                value.Physics.Motion = BodyDynamic;
                value.Physics.Mass = 4.0f;
            }
            if (motion == 2)
            {
                value.Physics.Motion = BodyNone;
            }
            int asset = cast<int>(Document.Data[at + 8]);

            if (kind == 1 && asset == 0)
            {
                value.Material.TextureSlot = 1;
            }
            if (ed_asset_kind(asset) == 1 && textureSlot < 64)
            {
                scene->BindTexture(textureSlot, ed_asset_handle(asset));
                value.Material.TextureSlot = textureSlot++;
            }

            // Models use their authored triangles, centered exactly like the rendered instance.
            BodySettings modelPhysics = value.Physics;
            if (kind == 6)
            {
                value.Material.Color = 0xFFFFFFFFu;
                value.Physics.Motion = BodyNone;
            }
            int slot = scene->FreeSlot();
            if (scene->Add(value) != 0)
            {
                if (kind == 6 && modelPhysics.Motion != BodyNone)
                {
                    RigidBody body =
                        CreateModelBody(scene->Physics, scene->Objects[slot].Id, ed_asset_handle(asset),
                                        value.Size, value.Transform, modelPhysics);
                    if (body.Handle == 0)
                    {
                        delete (scene);
                        Stop();
                        ed_status(
                            "Cannot build mesh collider. Check the model geometry or set Physics to None.");
                        return;
                    }
                    scene->Objects[slot].Body = body;
                    scene->Objects[slot].Physics = modelPhysics;
                }
                PlaySlots[i] = slot;
            }
        }

        Game->AddRoom(scene);

        if (!Game->Start(1, spawn))
        {
            Stop();
            ed_status("Player start is obstructed. Move the Player start marker to a free floor tile.");
            return;
        }

        Game->View.Yaw = yaw;
        Playing = true;
        ed_capture(1);
        ed_status("PLAY: WASD movement / mouse look / Space jump / E push / Esc stop.");
    }

    public void Action(int action)
    {
        if (action == 0)
        {
            return;
        }
        FinishGizmo(false);
        FinishStroke();
        if (action == 99)
        {
            Quit = true;
            return;
        }

        if (action >= 80 && action <= 82)
        {
            Brush = 0;
            GizmoMode = action - 79;
            ed_status("Drag a colored handle. Ctrl snaps; Esc cancels. Scale uses local axes.");
            return;
        }

        if (action == 6)
        {
            if (Playing)
            {
                Stop();
            }
            else if (ed_tile_suspend() != 0)
            {
                Play();
            }
            return;
        }

        if (Playing)
        {
            return;
        }

        if (action >= 1000 && action < 1000 + ed_layer_count())
        {
            WorldLayer = action - 1000;
            Document.ActiveLayer = WorldLayer;
            Selected = -1;
            return;
        }
        if (action == 112)
        {
            if (Selected >= 0 && !Document.CanEdit(Selected))
            {
                Selected = -1;
            }
            Document.Commit();
            return;
        }
        if ((action == 90 || action == 91 || (action >= 50 && action <= 63) ||
             (action >= 6000 && action < 6000 + ed_layer_count())) &&
            !Document.CanEditTree(Selected))
        {
            ed_status("Show and unlock the object's layer and child layers before editing.");
            return;
        }
        if (action == 109)
        {
            WorldLayer = ed_layer_count() - 1;
            Document.ActiveLayer = WorldLayer;
            Selected = -1;
            Document.Commit();
            return;
        }
        if (action == 111)
        {
            if (Document.RemoveLayer(ed_layer_delete_source(), ed_layer_delete_target()))
            {
                WorldLayer = Document.ActiveLayer;
                Selected = -1;
                Document.Commit();
            }
            return;
        }
        if (action == 108)
        {
            SoloLayer = !SoloLayer;
            return;
        }
        if (action >= 6000 && action < 6000 + ed_layer_count() && Selected >= 0)
        {
            if (ed_layer_editable(action - 6000) == 0)
            {
                ed_status("Show and unlock the destination layer first.");
                return;
            }
            RememberTransform();
            Document.Data[Selected * Stride + 15] = cast<float>(action - 6000);
            if (ConstrainTileChanges(&Document.Data[0], &TransformBefore[0]))
            {
                WorldLayer = action - 6000;
                Document.ActiveLayer = WorldLayer;
                Document.Commit();
            }
            else
            {
                for (int i = 0; i < RecordSize; i++)
                {
                    Document.Data[i] = TransformBefore[i];
                }
                ed_status("The destination layer already contains a tile here.");
            }
            return;
        }
        if (action == 91)
        {
            int copy = Document.Duplicate(Selected);
            if (copy >= 0)
            {
                Selected = copy;
                Brush = 0;
                Document.Commit();
            }
            return;
        }
        if (action == 92)
        {
            if (Document.Reparent(ed_parent_source(), ed_parent_target()))
            {
                Document.Commit();
            }
            return;
        }
        if (action == 90 && Selected >= 0)
        {
            float[] values = new float[9];
            if (ed_transform_values(&values[0]) != 0)
            {
                RememberTransform();
                int at = Selected * Stride;
                for (int i = 0; i < 3; i++)
                {
                    Document.Data[at + 1 + i] = values[i];
                    Document.Data[at + 5 + i] = values[6 + i];
                }
                Document.Data[at + 12] = values[3];
                Document.Data[at + 4] = values[4];
                Document.Data[at + 13] = values[5];
                FollowTransform();
                bool changed = false;
                for (int i = 0; i < RecordSize; i++)
                {
                    if (Document.Data[i] != TransformBefore[i])
                    {
                        changed = true;
                    }
                }
                if (changed)
                {
                    Document.Commit();
                }
            }
            delete (values);
            return;
        }

        if (action == 1 || action == 2)
        {
            if (!MayLeave())
            {
                return;
            }
            int create = 0;
            if (action == 1)
            {
                create = 1;
            }

            if (ed_project(create) != 0)
            {
                Texture = 0;
                TileAsset = 0;
                WorldLayer = 0;
                Document.ActiveLayer = 0;
                SoloLayer = false;
                Selected = -1;
                Document.Starter();
                ed_load(&Document.Data[0], Capacity, 1);
                Document.ResetHistory();
            }
        }

        if (action == 3)
        {
            Save(false);
        }
        if (action == 13)
        {
            Save(true);
        }

        if (action == 4 && MayLeave())
        {
            if (ed_load(&Document.Data[0], Capacity, 0) != 0)
            {
                Selected = -1;
                Document.ResetHistory();
                Document.Dirty = false;
                WorldLayer = 0;
                Document.ActiveLayer = 0;
                SoloLayer = false;
            }
        }

        if (action == 5 && MayLeave())
        {
            for (int i = 0; i < RecordSize; i++)
            {
                Document.Data[i] = 0.0f;
            }
            Selected = -1;
            WorldLayer = 0;
            Document.ActiveLayer = 0;
            SoloLayer = false;
            ed_new_scene();
            Document.ResetHistory();
            Document.Dirty = true;
        }

        if (action == 7)
        {
            Document.Restore(Document.Cursor - 1);
            WorldLayer = Document.ActiveLayer;
            Selected = -1;
        }
        if (action == 8)
        {
            Document.Restore(Document.Cursor + 1);
            WorldLayer = Document.ActiveLayer;
            Selected = -1;
        }
        if (action == 9)
        {
            ed_import(0);
        }
        if (action == 10)
        {
            ed_import(1);
        }
        if (action == 12)
        {
            ed_sound(ed_asset_id(), 0.7f);
        }
        if (action >= 20 && action <= 30)
        {
            Brush = action - 20;
        }
        if (action == 40)
        {
            Layer--;
        }
        if (action == 41)
        {
            Layer++;
        }
        if (action == 42)
        {
            Rotation += 90.0f;
            if (Rotation >= 360.0f)
            {
                Rotation = 0.0f;
            }
        }
        if (action == 70)
        {
            Selected = ed_hierarchy_selection();
            if (Selected >= 0)
            {
                WorldLayer = cast<int>(Document.Data[Selected * Stride + 15]);
                Document.ActiveLayer = WorldLayer;
            }
            Brush = 0;
        }

        if (action == 71)
        {
            TileAsset = 0;
            int kind = ed_asset_kind(ed_asset_id());
            if (kind == 5)
            {
                TileAsset = ed_asset_id();
            }
            if (kind == 1)
            {
                Texture = ed_asset_id();
                Brush = 1;
            }
            if (kind == 2 || kind == 5)
            {
                Brush = 6;
            }
            if (kind == 3)
            {
                Brush = 8;
            }
        }

        if (Selected < 0 || action < 50 || action > 64)
        {
            return;
        }
        int at = Selected * Stride;
        RememberTransform();
        bool changed = true;

        if (action == 50)
        {
            Document.Remove(Selected);
            Selected = -1;
        }
        if (action >= 51 && action <= 56)
        {
            int axis = (action - 51) / 2;
            float amount = 0.25f;
            if (IsWorldTile(&Document.Data[0], Selected))
            {
                amount = 2.0f;
            }
            float step = -amount;
            if (action % 2 == 0)
            {
                step = amount;
            }
            Document.Data[at + 1 + axis] += step;
        }

        if (action == 57)
        {
            Document.Data[at + 4] += 90.0f;
        }
        if (action == 58 || action == 59)
        {
            float scale = 0.8f;
            if (action == 59)
            {
                scale = 1.25f;
            }
            for (int i = 5; i <= 7; i++)
            {
                Document.Data[at + i] = Clamp(Document.Data[at + i] * scale, 0.02f, 1000.0f);
            }
        }

        if (action == 60 && IsWorldTile(&Document.Data[0], Selected))
        {
            ed_status("Tiles are static world geometry.");
            return;
        }
        if (action == 60)
        {
            Document.Data[at + 10] = cast<float>((cast<int>(Document.Data[at + 10]) + 1) % 3);
        }
        if (action == 61)
        {
            Document.Data[at + 11] = Max(0.0f, Document.Data[at + 11] - 0.1f);
        }
        if (action == 62)
        {
            float maximum = 32.0f;
            if (Document.Data[at] == 8.0f)
            {
                maximum = 1.0f;
            }
            Document.Data[at + 11] = Min(maximum, Document.Data[at + 11] + 0.1f);
        }
        if (action == 63)
        {
            if (ed_asset_kind(ed_asset_id()) == 1 && Document.Data[at] <= 5.0f)
            {
                Document.Data[at + 8] = cast<float>(ed_asset_id());
            }
            else
            {
                changed = false;
                ed_status("Select a texture and a primitive tile first.");
            }
        }

        if (action == 64)
        {
            Vector3 center =
                Vector3(Document.Data[at + 1], Document.Data[at + 2] + 1.0f, Document.Data[at + 3]);
            Camera.Position = Subtract(center, Scale(Camera.Forward(), 7.0f));
            changed = false;
        }

        if (changed)
        {
            if (action >= 51 && action <= 59)
            {
                FollowTransform();
            }
            Document.Commit();
        }
    }

    public int Pick()
    {
        int selected = -1;
        float nearest = 10000.0f;

        for (int i = 0; i < Capacity; i++)
        {
            int at = i * Stride;
            if (!Document.CanEdit(i) || cast<int>(Document.Data[at + 15]) != WorldLayer)
            {
                continue;
            }
            float distance = 0.0f;

            if (ed_pick(&Ray[0], Document.Data[at + 1], Document.Data[at + 2], Document.Data[at + 3],
                        Document.Data[at + 5], Document.Data[at + 6], Document.Data[at + 7],
                        Document.Data[at + 4], Document.Data[at + 12], Document.Data[at + 13],
                        &distance) != 0 &&
                distance < nearest)
            {
                selected = i;
                nearest = distance;
            }
        }

        return selected;
    }

    public bool TileBrush()
    {
        return Brush == 6 && ed_asset_kind(TileAsset) == 5;
    }

    public bool TileCellPoint(Vector3 *result)
    {
        int axis = 1;
        float depth = cast<float>(Layer) * 2.0f;
        if (Stroke && StrokePlane >= 0)
        {
            axis = StrokePlane;
            depth = StrokeDepth;
        }
        else
        {
            float[] hit = new float[7];
            float[] best = new float[7];
            float nearest = 10000.0f;
            Bounds occupied = Bounds(Vector3(0.0f, 0.0f, 0.0f), Vector3(0.0f, 0.0f, 0.0f));
            for (int i = 0; i < Capacity; i++)
            {
                if (!IsWorldTile(&Document.Data[0], i) ||
                    cast<int>(Document.Data[i * Stride + 15]) != WorldLayer)
                {
                    continue;
                }
                Bounds cells = TileCells(MakePrimitive(&Document.Data[0], i));
                Bounds bounds = Bounds(Scale(cells.Low, 2.0f), Scale(cells.High, 2.0f));
                if (ed_grid_ray(&Ray[0], cast<float *>(cast<void *>(&bounds)), &hit[0]) != 0 &&
                    hit[6] < nearest)
                {
                    nearest = hit[6];
                    occupied = cells;
                    for (int j = 0; j < 7; j++)
                    {
                        best[j] = hit[j];
                    }
                }
            }
            if (nearest < 200.0f)
            {
                float offset = 0.01f;
                if (Brush == 10)
                {
                    offset = -offset;
                }
                result->X = GridFloor((best[0] + best[3] * offset) * 0.5f) * 2.0f + 1.0f;
                result->Y = GridFloor((best[1] + best[4] * offset) * 0.5f) * 2.0f;
                result->Z = GridFloor((best[2] + best[5] * offset) * 0.5f) * 2.0f + 1.0f;
                if (Abs(best[3]) > 0.5f)
                {
                    axis = 0;
                }
                if (Abs(best[5]) > 0.5f)
                {
                    axis = 2;
                }
                if (TileBrush())
                {
                    Bounds candidate = TileCells(TilePlacement(TileAsset, *result, Rotation));
                    if (best[3] > 0.5f)
                    {
                        result->X += (occupied.High.X - candidate.Low.X) * 2.0f;
                    }
                    if (best[3] < -0.5f)
                    {
                        result->X += (occupied.Low.X - candidate.High.X) * 2.0f;
                    }
                    if (best[4] > 0.5f)
                    {
                        result->Y += (occupied.High.Y - candidate.Low.Y) * 2.0f;
                    }
                    if (best[4] < -0.5f)
                    {
                        result->Y += (occupied.Low.Y - candidate.High.Y) * 2.0f;
                    }
                    if (best[5] > 0.5f)
                    {
                        result->Z += (occupied.High.Z - candidate.Low.Z) * 2.0f;
                    }
                    if (best[5] < -0.5f)
                    {
                        result->Z += (occupied.Low.Z - candidate.High.Z) * 2.0f;
                    }
                }
                delete (hit);
                delete (best);
                if (Stroke)
                {
                    StrokePlane = axis;
                    StrokeDepth = result->Y;
                    if (axis == 0)
                    {
                        StrokeDepth = result->X;
                    }
                    if (axis == 2)
                    {
                        StrokeDepth = result->Z;
                    }
                }
                return true;
            }
            delete (hit);
            delete (best);
        }
        if (Abs(Ray[3 + axis]) < 0.0001f)
        {
            return false;
        }
        float t = (depth - Ray[axis]) / Ray[3 + axis];
        if (t < 0.0f || t > 200.0f)
        {
            return false;
        }
        result->X = GridFloor((Ray[0] + Ray[3] * t) * 0.5f) * 2.0f + 1.0f;
        result->Y = GridFloor((Ray[1] + Ray[4] * t + 0.001f) * 0.5f) * 2.0f;
        result->Z = GridFloor((Ray[2] + Ray[5] * t) * 0.5f) * 2.0f + 1.0f;
        if (axis == 0)
        {
            result->X = depth;
        }
        if (axis == 1)
        {
            result->Y = depth;
        }
        if (axis == 2)
        {
            result->Z = depth;
        }
        if (Stroke)
        {
            StrokePlane = axis;
            StrokeDepth = depth;
        }
        return true;
    }

    public bool CellPoint(Vector3 *result)
    {
        if (TileBrush() || Brush == 10)
        {
            return TileCellPoint(result);
        }
        if (Abs(Ray[4]) < 0.0001f)
        {
            return false;
        }
        float t = (cast<float>(Layer) * 2.0f - Ray[1]) / Ray[4];
        if (t < 0.0f || t > 200.0f)
        {
            return false;
        }
        float x = Ray[0] + Ray[3] * t;
        float z = Ray[2] + Ray[5] * t;
        result->X = GridFloor(x * 0.5f) * 2.0f + 1.0f;
        result->Y = cast<float>(Layer) * 2.0f;
        result->Z = GridFloor(z * 0.5f) * 2.0f + 1.0f;
        return true;
    }

    public void Update(float dt)
    {
        if (Playing)
        {
            if (Pressed(KeyEscape) || Pressed(294))
            {
                Stop();
                return;
            }
            PlayerInput input = PlayerInput();
            if (EditorKeyDown(KeyW))
            {
                input.Forward += 1.0f;
            }
            if (EditorKeyDown(KeyS))
            {
                input.Forward -= 1.0f;
            }
            if (EditorKeyDown(KeyD))
            {
                input.Side += 1.0f;
            }
            if (EditorKeyDown(KeyA))
            {
                input.Side -= 1.0f;
            }
            input.LookX = ed_look(0) * 0.0025f;
            input.LookY = -ed_look(1) * 0.0025f;
            input.Jump = Pressed(KeySpace);
            Game->Update(input, dt);
            for (int i = 0; i < Capacity; i++)
            {
                int at = i * Stride;
                if (Document.Data[at] == 8.0f)
                {
                    Vector3 position =
                        Vector3(Document.Data[at + 1], Document.Data[at + 2], Document.Data[at + 3]);
                    float volume =
                        Document.Data[at + 11] *
                        Clamp(1.0f - Length(Subtract(position, Game->View.Position)) / 12.0f, 0.0f, 1.0f);
                    ed_voice(i, cast<int>(Document.Data[at + 8]), volume);
                }
            }
            if (Pressed(69))
            {
                Game->Push(5.0f, 12.0f);
            }
            if (Game->View.Position.Y < -50.0f)
            {
                Stop();
                ed_status("Player fell out of the map. Add floor tiles or move the spawn marker.");
            }
            return;
        }

        // A drag is one transaction. Camera motion, selection and document commands wait for release.
        if (ed_gizmo_active() != 0)
        {
            Vector3 direction = Camera.Forward();
            ed_ray(&Ray[0], Camera.Position.X, Camera.Position.Y, Camera.Position.Z, direction.X, direction.Y,
                   direction.Z, Camera.VerticalFov);
            int cancel = 0;
            if (Pressed(KeyEscape))
            {
                cancel = 1;
            }
            int result = ed_gizmo_update(&Document.Data[Selected * Stride], GizmoMode, ed_control(), cancel);
            if (result == 4)
            {
                for (int i = 0; i < RecordSize; i++)
                {
                    Document.Data[i] = TransformBefore[i];
                }
            }
            else
            {
                FollowTransform();
            }
            if (result == 2)
            {
                Document.Commit();
            }
            return;
        }

        // Wheel navigation follows the hovered viewport without stealing keyboard focus.
        Camera.Position = Add(Camera.Position, Scale(Camera.Forward(), ed_wheel() * 1.5f));
        if (ed_input_blocked() != 0)
        {
            return;
        }
        bool control = ed_control() != 0;
        if (control && Pressed(68))
        {
            Action(91);
        }
        if (control && Pressed(83))
        {
            Action(3);
        }
        if (control && Pressed(90))
        {
            Action(7);
        }
        if (control && Pressed(89))
        {
            Action(8);
        }
        if (Pressed(294))
        {
            Action(6);
            return;
        }
        if (Pressed(86))
        {
            Brush = 0;
        }
        bool navigation = ed_mouse(4) != 0 || Flying;
        if (!control && !navigation)
        {
            if (Pressed(87))
            {
                Action(80);
            }
            if (Pressed(69))
            {
                Action(81);
            }
            if (Pressed(82))
            {
                if (Brush == 0)
                {
                    Action(82);
                }
                else
                {
                    Action(42);
                }
            }
        }
        if (Pressed(91))
        {
            Action(40);
        }
        if (Pressed(93))
        {
            Action(41);
        }
        if (Pressed(261))
        {
            Action(50);
        }
        if (Pressed(70))
        {
            Action(64);
        }
        bool inside = ed_mouse(0) != 0;
        bool flying = ed_mouse(4) != 0 && (inside || Flying);

        if (flying != Flying)
        {
            Flying = flying;
            int capture = 0;
            if (flying)
            {
                capture = 1;
            }
            ed_capture(capture);
        }

        if (Flying)
        {
            FinishStroke();
            Camera.Look(ed_look(0) * 0.003f, -ed_look(1) * 0.003f);
            Camera.Pitch = Clamp(Camera.Pitch, -1.52f, 1.52f);
            Vector3 movement = Vector3(0.0f, 0.0f, 0.0f);
            if (EditorKeyDown(KeyW))
            {
                movement = Add(movement, Camera.Forward());
            }
            if (EditorKeyDown(KeyS))
            {
                movement = Subtract(movement, Camera.Forward());
            }
            if (EditorKeyDown(KeyD))
            {
                movement = Add(movement, Camera.Right());
            }
            if (EditorKeyDown(KeyA))
            {
                movement = Subtract(movement, Camera.Right());
            }
            if (EditorKeyDown(69))
            {
                movement.Y += 1.0f;
            }
            if (EditorKeyDown(81))
            {
                movement.Y -= 1.0f;
            }
            float speed = 10.0f;
            if (EditorKeyDown(340))
            {
                speed = 24.0f;
            }
            Camera.Position = Add(Camera.Position, Scale(movement, dt * speed));
            return;
        }

        Vector3 forward = Camera.Forward();
        ed_ray(&Ray[0], Camera.Position.X, Camera.Position.Y, Camera.Position.Z, forward.X, forward.Y,
               forward.Z, Camera.VerticalFov);
        if (ed_mouse(3) != 0)
        {
            FinishStroke();
        }
        if (Brush == 0 && Document.CanEditTree(Selected))
        {
            if (ed_mouse(1) != 0)
            {
                RememberTransform();
            }
            int result = ed_gizmo_update(&Document.Data[Selected * Stride], GizmoMode, ed_control(), 0);
            if (result != 0)
            {
                FollowTransform();
            }
            if (result == 2)
            {
                Document.Commit();
            }
            if (result != 0)
            {
                return;
            }
        }

        if (!inside || control || ed_layer_editable(WorldLayer) == 0)
        {
            return;
        }

        if (Brush == 0)
        {
            if (ed_mouse(1) != 0)
            {
                Selected = Pick();
            }
            return;
        }

        if (ed_mouse(1) != 0)
        {
            Stroke = true;
        }
        if (!Stroke || ed_mouse(2) == 0)
        {
            return;
        }
        Vector3 cell = Vector3(0.0f, 0.0f, 0.0f);
        if (!CellPoint(&cell))
        {
            return;
        }
        if (HasLastCell && (TileBrush() || Brush == 10 || LastCell.Y == cast<float>(Layer) * 2.0f))
        {
            Vector3 previous = LastCell;
            float distance =
                Max(Max(Abs(cell.X - previous.X), Abs(cell.Z - previous.Z)), Abs(cell.Y - previous.Y));
            int steps = cast<int>(Min(cast<float>(Capacity), distance * 0.5f));

            for (int i = 1; i < steps; i++)
            {
                Vector3 point =
                    Add(previous, Scale(Subtract(cell, previous), cast<float>(i) / cast<float>(steps)));
                point.X = GridFloor(point.X * 0.5f) * 2.0f + 1.0f;
                point.Z = GridFloor(point.Z * 0.5f) * 2.0f + 1.0f;
                point.Y = GridFloor(point.Y * 0.5f + 0.5f) * 2.0f;
                PaintCell(point);
            }
        }

        PaintCell(cell);
    }

    public void PaintCell(Vector3 cell)
    {
        if (ed_layer_editable(WorldLayer) == 0)
        {
            return;
        }
        if (HasLastCell && LastCell.X == cell.X && LastCell.Y == cell.Y && LastCell.Z == cell.Z)
        {
            return;
        }
        LastCell = cell;
        HasLastCell = true;
        Document.ActiveLayer = WorldLayer;
        int existing = Document.Cell(cell.X, cell.Y, cell.Z, Brush);
        if (existing >= 0 && !Document.CanEditTree(existing))
        {
            return;
        }
        if (Brush == 9)
        {
            for (int i = 0; i < Capacity; i++)
            {
                if (Document.Data[i * Stride] == 9.0f && !Document.CanEditTree(i))
                {
                    return;
                }
            }
        }

        if (Brush == 10)
        {
            if (existing >= 0)
            {
                Document.Remove(existing);
                Changed = true;
                Selected = -1;
            }
            return;
        }

        int asset = Texture;
        if (Brush == 6 || Brush == 8)
        {
            asset = ed_asset_id();
            if (TileBrush())
            {
                asset = TileAsset;
            }
            int expected = 2;
            if (Brush == 8)
            {
                expected = 3;
            }
            if (ed_asset_kind(asset) != expected && !(expected == 2 && ed_asset_kind(asset) == 5))
            {
                ed_status("Select a matching model or sound in Resources first.");
                return;
            }
        }
        if (Brush >= 7 && Brush != 8)
        {
            asset = 0;
        }

        // Props do not erase the supporting floor; structural tiles replace the cell.
        if (existing >= 0 && Brush <= 5)
        {
            Document.Remove(existing);
        }
        if (Brush == 9)
        {
            for (int i = 0; i < Capacity; i++)
            {
                if (Document.Data[i * Stride] == 9.0f)
                {
                    Document.Remove(i);
                }
            }
        }
        Selected = Document.Add(Brush, cell, Rotation, asset, (Brush - 1) % 5);
        Changed = Changed || Selected >= 0;
    }

    public bool LayerVisible(int layer)
    {
        return ed_layer_visible(layer) != 0 && (!SoloLayer || layer == WorldLayer);
    }

    public void Render()
    {
        if (!Playing)
        {
            Vector3 direction = Camera.Forward();
            ed_ray(&Ray[0], Camera.Position.X, Camera.Position.Y, Camera.Position.Z, direction.X, direction.Y,
                   direction.Z, Camera.VerticalFov);
        }
        ed_view_begin();
        Camera view = Camera;
        if (Playing)
        {
            view = Game->View;
        }
        BeginWorld(&view);
        ox_lights_reset(0.32f, 0.34f, 0.38f);
        ox_light(0, -0.4f, -1.0f, -0.3f, 0xE0EEFFFFu, 0.7f, 1.0f);

        for (int i = 0; i < Capacity; i++)
        {
            int at = i * Stride;
            if (Document.Data[at] == 7.0f && (Playing || LayerVisible(cast<int>(Document.Data[at + 15]))))
            {
                ox_light(1, Document.Data[at + 1], Document.Data[at + 2], Document.Data[at + 3],
                         Palette(cast<int>(Document.Data[at + 9])), Document.Data[at + 11], 12.0f);
            }
        }

        ResetGeometryClip();

        for (int i = 0; i < Capacity; i++)
        {
            int at = i * Stride;
            int kind = cast<int>(Document.Data[at]);
            if (kind == 0 || (Playing && kind >= 7) ||
                (!Playing && !LayerVisible(cast<int>(Document.Data[at + 15]))))
            {
                continue;
            }
            Primitive value = MakePrimitive(&Document.Data[0], i);

            if (Playing)
            {
                Scene *scene = Game->Rooms[0].Value;
                int slot = PlaySlots[i];
                if (slot >= 0)
                {
                    value.Transform = scene->Objects[slot].Transform;
                }
            }

            int asset = cast<int>(Document.Data[at + 8]);
            int texture = 0;
            if (kind == 1 && asset == 0)
            {
                texture = Checker;
            }
            if (ed_asset_kind(asset) == 1)
            {
                texture = ed_asset_handle(asset);
            }
            Vector3 p = value.Transform.Position;
            Quaternion q = value.Transform.Rotation;
            Vector3 size = value.Size;

            if (kind == 6 && ed_asset_handle(asset) != 0)
            {
                int model = ed_asset_handle(asset);
                Bounds bounds = ModelBounds(model);
                Vector3 extent = Subtract(bounds.High, bounds.Low);
                Vector3 scale = Vector3(size.X / Max(0.02f, extent.X), size.Y / Max(0.02f, extent.Y),
                                        size.Z / Max(0.02f, extent.Z));
                Vector3 center = Scale(Add(bounds.High, bounds.Low), 0.5f);
                center = Vector3(center.X * scale.X, center.Y * scale.Y, center.Z * scale.Z);
                Pose pose = value.Transform;
                pose.Position = Subtract(p, Rotate(q, center));
                DrawModelPose(model, pose, scale, 0xFFFFFFFFu);
            }
            else
            {
                uint color = value.Material.Color;
                if (kind == 6)
                {
                    color = 0xFF55AAFFu;
                }
                ox_primitive(value.Shape, p.X, p.Y, p.Z, q.X, q.Y, q.Z, q.W, size.X, size.Y, size.Z, color,
                             texture, 2.0f, value.Material.Emission);
            }
        }

        if (!Playing)
        {
            if (Grid)
            {
                ed_grid(cast<float>(Layer) * 2.0f + 0.008f, Camera.Position.X, Camera.Position.Z);
            }
            if (Selected >= 0 && LayerVisible(cast<int>(Document.Data[Selected * Stride + 15])))
            {
                int at = Selected * Stride;
                if (IsWorldTile(&Document.Data[0], Selected))
                {
                    Bounds cells = TileCells(MakePrimitive(&Document.Data[0], Selected));
                    ed_outline(cells.Low.X + cells.High.X, cells.Low.Y * 2.0f, cells.Low.Z + cells.High.Z,
                               (cells.High.X - cells.Low.X) * 2.0f, (cells.High.Y - cells.Low.Y) * 2.0f,
                               (cells.High.Z - cells.Low.Z) * 2.0f, 0xFFC879FFu);
                }
                else
                {
                    ed_object_outline(&Document.Data[at]);
                }
                if (Brush == 0 && !Flying && Document.CanEditTree(Selected))
                {
                    ed_gizmo_draw(&Document.Data[at], GizmoMode);
                }
            }

            Vector3 cell = Vector3(0.0f, 0.0f, 0.0f);
            if (Brush > 0 && ed_layer_editable(WorldLayer) != 0 && ed_mouse(0) != 0 && !Flying &&
                CellPoint(&cell))
            {
                if (TileBrush())
                {
                    Bounds cells = TileCells(TilePlacement(TileAsset, cell, Rotation));
                    uint color = 0x6BE0C0FFu;
                    if (!TileSpaceFree(&Document.Data[0], cells, WorldLayer, -1))
                    {
                        color = 0xFF6666FFu;
                    }
                    ed_outline(cells.Low.X + cells.High.X, cells.Low.Y * 2.0f, cells.Low.Z + cells.High.Z,
                               (cells.High.X - cells.Low.X) * 2.0f, (cells.High.Y - cells.Low.Y) * 2.0f,
                               (cells.High.Z - cells.Low.Z) * 2.0f, color);
                }
                else
                {
                    ed_outline(cell.X, cell.Y, cell.Z, 2.0f, 0.06f, 2.0f, 0x6BE0C0FFu);
                }
            }
        }

        EndWorld();
        int playing = 0;
        if (Playing)
        {
            playing = 1;
        }
        ed_view_end(playing);
    }
}
