using Oxygen;
using Xenon.Text;
using Xenon.IO;

namespace OxygenEditor;

extern void ed_bind_tile_session(function int(int, float *, float *, float *, byte *, readonly byte *) *
                                 callback);
extern void ed_tile_document_view(int field, readonly byte *value);
extern void ed_tile_reset_gestures();

// The view holds window state and camera parameters shared with the graphics binding.
// open, dirty, focused, face, mode, tool, duplicate pending, yaw, pitch, distance, target XYZ.
struct TileSession
{
    public bool NewRequested;
    public String Pending;
    public String ResourceRequest;

    public TileSession()
    {
        Pending = String();
        ResourceRequest = String();
    }

    public bool Guard(float *view)
    {
        if (view[1] == 0.0f)
        {
            return true;
        }
        int answer = ed_dialog_guard();
        if (answer == 0)
        {
            return false;
        }
        if (answer == 2 && ed_tile_panel_action(0) == 0)
        {
            return false;
        }
        view[1] = 0.0f;
        return true;
    }

    public int Prepare(float *data, float *selection, float *view, byte *name)
    {
        if (ResourceRequest.ByteLength > 0)
        {
            String requested = ResourceRequest;
            ResourceRequest = String();
            if (Guard(view))
            {
                Pending = requested;
            }
        }
        view[2] = 0.0f;
        int action = 0;
        if (NewRequested)
        {
            NewRequested = false;
            ed_tile_reset_gestures();
            view[0] = 1.0f;
            view[1] = 0.0f;
            view[3] = -1.0f;
            ed_tile_document_view(0, "");
            ed_tile_document_view(1, "");
            CopyText(name, String("Untitled"));
            view[7] = 0.7f;
            view[8] = 0.45f;
            view[9] = 7.0f;
            view[10] = 0.0f;
            view[11] = 1.0f;
            view[12] = 0.0f;
            action = 1;
        }
        if (Pending.ByteLength > 0)
        {
            try
            {
                TileMetadata meta = TileMetadata();
                if (ReadTileFile(AssetFile(Pending), data, &meta))
                {
                    ed_tile_reset_gestures();
                    ed_tile_document_view(0, Pending.CString);
                    String folder = String(Path.GetDirectoryName(Pending.AsView()));
                    if (File.Exists(AssetFile(JoinPath(folder, String("tileset.oxtileset")))))
                    {
                        ed_tileset_view(2, folder.CString);
                    }
                    ed_tile_document_view(1, meta.Texture.CString);
                    CopyText(name, meta.Name);
                    view[0] = 1.0f;
                    view[1] = 0.0f;
                    view[3] = -1.0f;
                    float[] bounds = float[4];
                    FrameTile(data, &bounds[0]);
                    view[10] = bounds[0];
                    view[11] = bounds[1];
                    view[12] = bounds[2];
                    view[9] = bounds[3] * 1.6f;
                    action = 23;
                }
                else
                {
                    ed_status("Cannot open malformed tile.");
                }
            }
            catch (...)
            {
                ed_status("Cannot open malformed tile.");
            }
            Pending = String();
        }
        if (view[0] != 0.0f && view[6] != 0.0f)
        {
            view[6] = 0.0f;
            view[3] = cast<float>(FirstSelectedTileFace(data, selection));
            view[4] = 2.0f;
            view[5] = 0.0f;
        }
        return action;
    }

    public void Reset()
    {
        NewRequested = false;
        Pending = String();
        ResourceRequest = String();
        TileSetsDispatch(6, "", 0, null, "", 0);
        TilePaletteDispatch(3, null, 0);
    }
}

static struct TileSessionService
{
    public static TileSession *Session;
}

int TileSessionDispatch(int operation, float* data, float* selection, float* view, byte* name, readonly byte* path)
{
    TileSession *session = TileSessionService.Session;
    if (operation == 0)
    {
        return session->Prepare(data, selection, view, name);
    }
    if (operation == 1)
    {
        return UiFlag(session->Guard(view));
    }
    if (operation == 2)
    {
        session->Reset();
    }
    if (operation == 3)
    {
        session->NewRequested = true;
    }
    if (operation == 4)
    {
        session->Pending = String(path);
    }
    if (operation == 5)
    {
        session->ResourceRequest = String(path);
    }
    if (operation == 6)
    {
        int action = cast<int>(view[13]);
        if (view[14] == 0.0f && session->Guard(view))
        {
            view[0] = 0.0f;
            view[2] = 0.0f;
        }
        if (action >= 2 && action <= 27 && action != 17 && action != 23)
        {
            view[1] = 1.0f;
        }
        if (view[15] != 0.0f)
        {
            AtlasDispatch(3, null, null, null, null, null, null);
        }
        for (int i = 0; i < 16; i++)
        {
            if (data[i] != data[i] || Abs(data[i]) > 3.402823466e38f)
            {
                data[i] = 0.0f;
            }
        }
    }
    if (operation == 7)
    {
        if (!session->Guard(view))
        {
            return 0;
        }
        view[0] = 0.0f;
        view[2] = 0.0f;
        return 1;
    }
    return 0;
}
